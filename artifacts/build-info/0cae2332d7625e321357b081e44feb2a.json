		"sources": {
			"contracts/types/DeworkTypes.sol": {
				"content": "// SPDX-License-Identifier: GPL-3.0\r\n\r\npragma solidity >=0.8.2 <0.9.0;\r\n\r\nstruct FreelancerProfile{\r\n\r\n    uint256 id;\r\n    string name;\r\n    address wallet;\r\n    uint8 experienceYears;\r\n    bool isAvailableHire;\r\n    uint256 hourlyRateWei;\r\n}\r\n\r\nstruct EmployerProfile{\r\n\r\n    uint256 id;\r\n    string name;\r\n    address wallet;\r\n    bool isHiring;\r\n    JobListing[] jobListing;\r\n}\r\n\r\nstruct CreateJobListingInput{\r\n\r\n    string title;\r\n    string description;\r\n    uint256 deadlineTimestamp;\r\n    uint256 fixedPriceInWei;\r\n}\r\n\r\nstruct JobListing{\r\n    uint256 id;\r\n    string title;\r\n    string description;\r\n    uint256 deadlineTimestamp;\r\n    bool isOpen;\r\n    uint256 fixedPriceInWei;\r\n    uint256 hiredFreelancerId;\r\n    bool hasHiredFreelancer;\r\n    bool isPaid;\r\n}\r\n\r\n"
			}
		}
	},
